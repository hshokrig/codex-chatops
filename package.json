{
  "name": "codex-chatops",
  "version": "0.1.0",
  "private": true,
  "description": "Discord-first private ChatOps bridge for Codex",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "smoke:local": "tsx src/scripts/smoke.ts",
    "bootstrap:discord": "tsx src/scripts/bootstrap-discord.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@openai/codex-sdk": "^0.120.0",
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.26.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.8.4",
    "pino": "^10.3.1",
    "simple-git": "^3.36.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitest/coverage-v8": "^4.0.3",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^16.0.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  }
}
